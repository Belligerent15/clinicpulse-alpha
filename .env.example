# =========================================
# ClinicPulse — Environment Variables
# =========================================

# 1. Secret Key (Used to encrypt session cookies)
# Generate a strong one using this command in your terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# 2. Admin Login Credentials
# These are the credentials you will use at /admin/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# 3. Database Path (Optional)
# Where the SQLite file is stored. 
# For local development, leave this as is.
# For Render deployment (with a persistent disk), it might be /data/clinicpulse.db
DATABASE_PATH=clinicpulse.db
