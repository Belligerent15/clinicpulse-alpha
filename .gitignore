# =========================================
# ClinicPulse .gitignore
# =========================================

# 1. Environment Variables (CRITICAL: Never commit your passwords!)
.env
.env.local
.env.*.local

# 2. Database files (Render will generate these)
*.db
*.sqlite
*.sqlite3
clinicpulse.db

# 3. Python Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# 4. Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 5. Flask instance folder (sometimes holds local DBs)
instance/
.webassets-cache

# 6. OS / IDE files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# 7. Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 8. Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
